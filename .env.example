# =====================================================================
# Hindsight on Coolify -- environment variables
# Copy these into Coolify (resource -> Environment Variables) or a .env.
# Do NOT commit your real .env (see .gitignore).
# =====================================================================

# --- PostgreSQL (bundled service) -----------------------------------
POSTGRES_USER=hindsight
POSTGRES_DB=hindsight
# REQUIRED. Use a long, URL-safe password (avoid @ : / # ? which break the
# connection URL). Generate e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- LLM provider ----------------------------------------------------
# Allowed values:
#   openai, openai-codex, claude-code, anthropic, gemini, groq, minimax,
#   deepseek, zai, opencode-go, ollama, ollama-cloud, lmstudio, llamacpp,
#   vertexai, bedrock, litellm, litellmrouter, volcano, openrouter, none
HINDSIGHT_API_LLM_PROVIDER=anthropic
HINDSIGHT_API_LLM_MODEL=claude-sonnet-4-5-20250929
# REQUIRED for anthropic (and most API-key providers). Your Anthropic API key.
HINDSIGHT_API_LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Embeddings / reranker ------------------------------------------
# Local = free, self-contained, but downloads models and wants ~2-4 GB RAM
# in the hindsight-api container. Switch to openai/cohere/etc. to offload.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_RERANKER_PROVIDER=local

# --- Vector extension (matches the pgvector/pgvector image) ----------
HINDSIGHT_API_VECTOR_EXTENSION=pgvector

# --- Worker identity (keep stable across restarts) -------------------
HINDSIGHT_API_WORKER_ID=hindsight-worker-1

# --- Control plane (web UI) -----------------------------------------
# REQUIRED: login key that protects the UI.
HINDSIGHT_CP_ACCESS_KEY=change-me-to-a-long-random-string
# Default talks to the API over the internal network. Override with the API's
# public URL only if your browser needs to call the API directly.
# HINDSIGHT_CP_DATAPLANE_API_URL=https://your-api-domain

# --- OPTIONAL: protect the public data-plane API with an API key -----
# Enable BOTH to require a key on API/MCP requests:
# HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
# HINDSIGHT_API_TENANT_API_KEY=change-me-to-a-long-random-string

# --- Logging ---------------------------------------------------------
HINDSIGHT_API_LOG_FORMAT=json
