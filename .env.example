# =====================================================================
# Hindsight on Coolify -- environment variables
#
# On Coolify you normally only need to set ONE value: your LLM API key.
# The database password, API key gate, and UI login key are auto-generated
# by Coolify's magic SERVICE_PASSWORD_* variables and shown (editable) in the
# Coolify UI -- grab the API key from there for your external clients.
#
# This file is mainly for LOCAL `docker compose` testing, where the magic
# SERVICE_* variables are NOT generated and must be set by hand (see bottom).
# Do NOT commit your real .env (see .gitignore).
# =====================================================================

# --- Hindsight image version (pins API + control-plane) --------------
# See https://github.com/vectorize-io/hindsight/releases for tags.
HINDSIGHT_VERSION=0.7.1

# --- LLM provider (the only secret you must provide) -----------------
# Allowed providers: openai, openai-codex, claude-code, anthropic, gemini,
# groq, minimax, deepseek, zai, opencode-go, ollama, ollama-cloud, lmstudio,
# llamacpp, vertexai, bedrock, litellm, litellmrouter, volcano, openrouter, none
HINDSIGHT_API_LLM_PROVIDER=anthropic
HINDSIGHT_API_LLM_MODEL=claude-sonnet-4-5-20250929
# REQUIRED for anthropic and most API-key providers. (Providers like ollama/none
# don't need a real key -- set any placeholder to satisfy the required check.)
HINDSIGHT_API_LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional tunables (sane defaults already baked into the compose) -
# POSTGRES_USER=hindsight
# POSTGRES_DB=hindsight
# HINDSIGHT_API_VECTOR_EXTENSION=pgvector
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
# HINDSIGHT_API_RERANKER_PROVIDER=local
# HINDSIGHT_API_WORKER_ID=hindsight-worker-1
# HINDSIGHT_API_LOG_FORMAT=json
# Set empty to turn OFF the data-plane API key gate:
# HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
# Point the UI at a different API URL (default: internal http://hindsight-api:8888):
# HINDSIGHT_CP_DATAPLANE_API_URL=https://your-api-domain

# =====================================================================
# LOCAL docker-compose only: Coolify generates these automatically, but
# plain `docker compose` does not. Set them yourself to test locally.
# Generate each with: openssl rand -hex 24
# =====================================================================
# SERVICE_PASSWORD_POSTGRES=change-me-postgres-password
# SERVICE_PASSWORD_TENANT=change-me-api-key
# SERVICE_PASSWORD_CPACCESS=change-me-ui-login-key
